# Copy to .env via:  python scripts/init_env.py   (generates all CHANGE_ME values)
# .env is git-ignored. Only this template is committed.
# Keep comments on their own lines: inline comments are parsed differently by tools.

# ---- Airflow image / runtime ----
AIRFLOW_VERSION=3.3.2
# Linux: must equal `id -u` (init_env.py sets it). Windows/macOS: 50000 is fine.
AIRFLOW_UID=50000
AIRFLOW_PORT=8080

# ---- Airflow secrets ----
AIRFLOW_FERNET_KEY=CHANGE_ME
AIRFLOW_JWT_SECRET=CHANGE_ME
AIRFLOW_API_SECRET_KEY=CHANGE_ME

# ---- Airflow admin (UI login) ----
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME

# ---- Airflow metadata database (separate from the warehouse) ----
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=CHANGE_ME

# ---- Warehouse (stage / silver / mart) ----
DWH_DB=dwh
DWH_USER=dwh_user
DWH_PASSWORD=CHANGE_ME
# Port published on YOUR machine (for DBeaver / VS Code SQL extensions). Containers use 5432 internally.
DWH_PORT=5433

# ---- Source API (Northwind OData V4: free, public, no API key) ----
SOURCE_API_BASE_URL=https://services.odata.org/V4/Northwind/Northwind.svc
# Business calendar timezone (Azerbaijan: UTC+4, no DST). Airflow itself stays on UTC.
BUSINESS_TIMEZONE=Asia/Baku
